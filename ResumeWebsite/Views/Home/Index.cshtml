@{
    ViewData["Title"] = "Home";
    ViewBag.ActivePage = "Home";
}

<!-- Hero Section -->
<div class="row g-4 align-items-center mb-5">
    <div class="col-lg-7">
        <div class="badge bg-success bg-opacity-10 text-success px-3 py-2 mb-3 rounded-pill">
            <i class="bi bi-person-badge me-1"></i> IT Professional
        </div>
        <h1 class="display-2 fw-bold mb-3">
            Daniel <span class="text-success">Hernandez</span>
        </h1>
        <h2 class="h3 text-muted fw-normal mb-4">
            <i class="bi bi-arrow-right-circle-fill text-success me-2"></i>
            IT Support Specialist &amp; Recent Graduate
        </h2>
        <p class="lead mb-4">
            I am a DePaul University graduate with a Bachelors in Information Technology and CCNA certification. I enjoy working all technology and find pleasure 
        in continuing to learn about tech as it evolves and grows. Thank you for taking time to explore my website.
        </p>
        <div class="d-flex gap-3 flex-wrap">
            <a href="@Url.Action("Projects", "Home")" class="btn btn-success btn-lg px-4">
                <i class="bi bi-folder-fill me-2"></i>View My Projects
            </a>
            <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-success btn-lg px-4">
                <i class="bi bi-envelope-fill me-2"></i>Get In Touch
            </a>
        </div>
    </div>
    <div class="col-lg-5 text-center">
        <div class="position-relative d-inline-block">
           <img src="~/dan_grad_pic.png"
     alt="Daniel Hernandez"
     class="rounded-circle img-fluid"
     style="width: 300px; height: 300px; object-fit: cover;">
            <!-- Floating badges -->
            <div class="position-absolute top-0 start-0 bg-success text-white rounded-circle p-2"
                 style="width: 50px; height: 50px; font-size: 12px; line-height: 1.2; text-align: center; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(45, 106, 79, 0.3);">
                A+
            </div>
            <div class="position-absolute bottom-0 end-0 bg-success text-white rounded-circle p-2"
                 style="width: 60px; height: 60px; font-size: 10px; line-height: 1.2; text-align: center; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(45, 106, 79, 0.3);">
                DePaul
            </div>
        </div>
    </div>
</div>

<!-- Credentials & Skills Section -->
<div class="row g-4 mb-5">
    <!-- Credentials -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100" style="background-color: rgba(45, 106, 79, 0.05);">
            <div class="card-body p-4 p-md-5">
                <h3 class="h4 mb-4">
                    <i class="bi bi-award-fill text-success me-2"></i>Credentials
                </h3>
                
                <!-- DePaul Degree -->
                <div class="d-flex align-items-start mb-4">
                    <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-mortarboard-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Bachelors of Arts in IT</div>
                        <div class="text-muted">DePaul University</div>
                        <span class="badge bg-success bg-opacity-10 text-success mt-1">Graduated 2026</span>
                    </div>
                </div>

                <!-- A+ Certification -->
                <div class="d-flex align-items-start mb-4">
                    <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-patch-check-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold">CompTIA A+ Certified</div>
                        <div class="text-muted">Candidate ID: COMP001022941956</div>
                        <span class="badge bg-success bg-opacity-10 text-success mt-1">Active</span>
                    </div>
                </div>

                <!-- Network+ Certification -->
                <div class="d-flex align-items-start mb-4">
                    <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-patch-check-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Network+ Certified</div>
                        <div class="text-muted">Candidate ID: COMP001022941956</div>
                        <span class="badge bg-success bg-opacity-10 text-success mt-1">Active</span>
                    </div>
                </div> 
            </div>
        </div>
    </div>

    <!-- Skills -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100" style="background-color: rgba(45, 106, 79, 0.05);">
            <div class="card-body p-4 p-md-5">
                <h3 class="h4 mb-4">
                    <i class="bi bi-tools text-success me-2"></i>Technical Skills
                </h3>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="bi bi-windows me-1"></i>Windows 10/11</span>
                        <span class="text-muted">Expert</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 95%;"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="bi bi-ubuntu me-1"></i>Linux (Ubuntu)</span>
                        <span class="text-muted">Proficient</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 70%;"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="bi bi-diagram-3 me-1"></i>Networking (TCP/IP, DNS, DHCP)</span>
                        <span class="text-muted">Proficient</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 80%;"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="bi bi-cloud me-1"></i>Azure / Active Directory</span>
                        <span class="text-muted">Intermediate</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 50%;"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="bi bi-code-square me-1"></i>PowerShell / Bash</span>
                        <span class="text-muted">Intermediate</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 50%;"></div>
                    </div>
                </div>

                <div class="mb-0">
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="bi bi-database me-1"></i>SQL / Database Management</span>
                        <span class="text-muted">Intermediate</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 50%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- About / Quick Stats -->
<div class="row g-4">
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-4" style="background-color: rgba(45, 106, 79, 0.05);">
            <div class="card-body p-4 p-md-5">
                <div class="row g-4 text-center">
                    <div class="col-md-3">
                        <div class="display-4 fw-bold text-success">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div class="fw-bold">DePaul</div>
                        <div class="text-muted small">IT Graduate</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-4 fw-bold text-success">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <div class="fw-bold">Network+ Certified</div>
                        <div class="text-muted small">CompTIA Certified</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-4 fw-bold text-success">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="fw-bold">2+ Years</div>
                        <div class="text-muted small">IT Experience</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-4 fw-bold text-success">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                        <div class="fw-bold">100+</div>
                        <div class="text-muted small">Tickets Resolved</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript"
        async
        src="https://cdn.credly.com/assets/utilities/embed.js">
</script>