@{
    ViewData["Title"] = "Contact";
    ViewBag.ActivePage = "Contact";
}

<div class="row g-4">
    <!-- Page Header -->
    <div class="col-12">
        <h1 class="display-4 fw-bold">
            <i class="bi bi-envelope-fill text-success me-2"></i>Contact Me
        </h1>
        <p class="lead text-muted">
            Feel free to connect or reach out!
        </p>
        <hr class="border-success opacity-25" style="width: 80px; border-width: 3px;" />
    </div>

    <!-- Left Column - Contact Info -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100" style="background-color: rgba(45, 106, 79, 0.05);">
            <div class="card-body p-4 p-md-5">
                <h3 class="h4 mb-4">
                    <i class="bi bi-person-badge-fill text-success me-2"></i>My Contact Information
                </h3>

                <!-- Email -->
                <div class="d-flex align-items-start mb-4">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-envelope-fill text-success fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-semibold small text-uppercase text-muted">Email</div>
                        <a href="mailto:dhernandezzz149@gmail.com" class="text-decoration-none text-success fs-5">
                            dhernandezzz149@gmail.com
                        </a>
                    </div>
                </div>

                <!-- Phone -->
                <div class="d-flex align-items-start mb-4">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-phone-fill text-success fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-semibold small text-uppercase text-muted">Phone</div>
                        <a href="tel:+17734411091" class="text-decoration-none text-success fs-5">
                            +1 (773) 441-1091
                        </a>
                    </div>
                </div>

                <!-- Location -->
                <div class="d-flex align-items-start mb-4">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-geo-alt-fill text-success fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-semibold small text-uppercase text-muted">Location</div>
                        <span class="fs-5">Chicago, Illinois</span>
                    </div>
                </div>

                <!-- Availability -->
                <div class="d-flex align-items-start">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-clock-fill text-success fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-semibold small text-uppercase text-muted">Availability</div>
                        <span class="fs-5">Mon-Sun · 9am-10pm</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column - Social & Quick Links -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 mb-4" style="background-color: rgba(45, 106, 79, 0.05);">
            <div class="card-body p-4 p-md-5">
                <h3 class="h4 mb-4">
                    <i class="bi bi-share-fill text-success me-2"></i>Connect With Me
                </h3>
                <p class="text-muted mb-4">
                    Find me on these platforms for more information about me.
                </p>

                <div class="d-flex gap-3 flex-wrap">
                    <a href="https://www.linkedin.com/in/daniel-hernandez-334a812bb/" target="_blank" class="btn btn-outline-success rounded-circle p-3"
                           style="width: 60px; height: 60px;" title="LinkedIn">
                        <i class="bi bi-linkedin fs-4"></i>
                    </a>
                </div>

                <hr class="my-4" />

                <div class="bg-success bg-opacity-10 rounded-3 p-3 text-center">
                    <i class="bi bi-chat-quote-fill text-success fs-4 d-block mb-2"></i>
                    <p class="mb-0 fst-italic text-muted">
                        "I am excited to explore any new opportunities!"
                    </p>
                </div>
            </div>
        </div>

        <!-- Quick Response Note -->
        <div class="card shadow-sm border-0 rounded-4" style="background-color: rgba(45, 106, 79, 0.05);">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3">
                        <i class="bi bi-clock-history text-success fs-5"></i>
                    </div>
                    <div>
                        <span class="fw-semibold">Quick Response:</span>
                        <span class="text-muted">I typically reply within 24 hours.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
