<!-- SCRIPTS - Copy & Share Functionality -->
<!-- ======================================== -->
<script>
    // Copy Resume to Clipboard
    function copyResume() {
        const resumeText = document.getElementById('resumeContent').innerText;
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(resumeText).then(function() {
                showToast('Resume copied to clipboard!', 'success');
            }).catch(copyResumeFallback);
        } else {
            copyResumeFallback();
        }
    }

    function copyResumeFallback() {
        const range = document.createRange();
        range.selectNode(document.getElementById('resumeContent'));
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
        document.execCommand('copy');
        window.getSelection().removeAllRanges();
        showToast('Resume copied to clipboard!', 'success');
    }

    // Share Resume
    function shareResume() {
        if (navigator.share) {
            navigator.share({
                title: 'Daniel Hernandez - IT Resume',
                text: 'Check out my IT resume!',
                url: window.location.href,
            }).catch(function() {
                // User cancelled or share failed
            });
        } else if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(window.location.href).then(function() {
                showToast('Link copied! Share it with your network.', 'info');
            }).catch(function() {
                prompt('Copy this URL to share:', window.location.href);
            });
        } else {
            prompt('Copy this URL to share:', window.location.href);
        }
    }

    // Toast Notification
    function showToast(message, type) {
        // Remove existing toasts
        const existing = document.querySelector('.toast-container');
        if (existing) existing.remove();

        // Create container
        const container = document.createElement('div');
        container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
        container.style.zIndex = '9999';

        // Create toast
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'info'} border-0 show`;
        toast.role = 'alert';
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-${type === 'success' ? 'check-circle-fill' : 'info-circle-fill'} me-2"></i>
                    ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        `;

        container.appendChild(toast);
        document.body.appendChild(container);

        // Auto-dismiss after 3 seconds
        setTimeout(function() {
            toast.classList.remove('show');
            setTimeout(function() {
                container.remove();
            }, 300);
        }, 3000);
    }
</script>

<!-- Toast Styles -->
<style>
    .toast-container {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 9999;
    }
    .toast {
        min-width: 280px;
        border-radius: 8px !important;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }
    .toast .btn-close {
        filter: brightness(0) invert(1);
    }
</style>