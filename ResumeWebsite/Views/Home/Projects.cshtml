            </div>
            
            <div class="card-body p-4">
                <!-- Title & Date -->
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title fw-bold mb-0">Azure Cloud Deployment</h5>
                    <span class="badge bg-success bg-opacity-10 text-success small">Nov 2024</span>
                </div>
                
                <!-- Description -->
                <p class="card-text text-muted small mb-3">
                    Deployed a web application to Microsoft Azure using App Service on Linux.
                    Configured environment variables, SSL certificates, and implemented CI/CD
                    pipeline using GitHub Actions for automated deployments.
                </p>
                
                <!-- Skills Tags -->
                <div class="d-flex flex-wrap gap-1 mb-3">
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">Azure</span>
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">App Service</span>
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">GitHub Actions</span>
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">CI/CD</span>
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">Linux</span>
                </div>
                
                <!-- View Button -->
                <a href="#" class="btn btn-outline-success btn-sm w-100">
                    <i class="bi bi-box-arrow-up-right me-1"></i>View Details
                </a>
            </div>
        </div>
    </div>

