@{
ViewData["Title"] = "Projects";
ViewBag.ActivePage = "Projects";
}

<!-- Page Header -->
<div class="row mb-5">
    <div class="col-12">
        <h1 class="display-4 fw-bold">
            <i class="bi bi-folder-fill text-success me-2"></i>My Projects
        </h1>
        <p class="lead text-muted">
            A collection of my IT projects showcasing my skills and experience.
        </p>
        <hr class="border-success opacity-25" style="width: 80px; border-width: 3px;" />
    </div>
</div>

<!-- Project Cards -->
<div class="row g-4">

    <!-- ======================================== -->
    <!-- PROJECT 1 - ACTIVE DIRECTORY LAB -->
    <!-- ======================================== -->
    <div class="col-lg-6 col-xl-4">
        <div class="card shadow-sm border-0 rounded-4 h-100 overflow-hidden"
             style="background-color: rgba(45, 106, 79, 0.05); transition: transform 0.3s ease;"
             onmouseenter="this.style.transform='translateY(-5px)'"
             onmouseleave="this.style.transform='translateY(0)'">
            
            <!-- Project Image -->
            <div class="bg-success bg-opacity-10 text-center p-4" style="min-height: 180px;">
                <i class="bi bi-diagram-3 text-success" style="font-size: 64px;"></i>
            </div>
            
            <div class="card-body p-4">
                <!-- Title & Date -->
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title fw-bold mb-0">Active Directory Lab</h5>
                    <span class="badge bg-success bg-opacity-10 text-success small">Dec 2024</span>
                </div>
                
                <!-- Description -->
                <p class="card-text text-muted small mb-3">
                    Built a fully functional Active Directory lab using Windows Server 2019 with
                    DNS, DHCP, and Group Policy. Configured user accounts, organizational units,
                    and implemented security policies for a simulated enterprise environment.
                </p>
                
                <!-- Skills Tags -->
                <div class="d-flex flex-wrap gap-1 mb-3">
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">Active Directory</span>
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">Windows Server</span>
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">DNS</span>
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">DHCP</span>
                    <span class="badge bg-success bg-opacity-15 text-white px-2 py-1">GPO</span>
                </div>
                
                <!-- View Button -->
                <a href="#" class="btn btn-outline-success btn-sm w-100">
                    <i class="bi bi-box-arrow-up-right me-1"></i>View Details
                </a>
            </div>
        </div>
    </div>

    <!-- ======================================== -->
    <!-- PROJECT 2 - AZURE CLOUD DEPLOYMENT -->
    <!-- ======================================== -->
    <div class="col-lg-6 col-xl-4">
        <div class="card shadow-sm border-0 rounded-4 h-100 overflow-hidden"
             style="background-color: rgba(45, 106, 79, 0.05); transition: transform 0.3s ease;"
             onmouseenter="this.style.transform='translateY(-5px)'"
             onmouseleave="this.style.transform='translateY(0)'">
            
            <!-- Project Image -->
